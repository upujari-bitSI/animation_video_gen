# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
# Make sure Ollama is running: ollama serve
OLLAMA_HOST=http://localhost:11434

# Light model (fast, ~2 GB RAM):
OLLAMA_MODEL=llama3.2:3b
# Better quality (needs ~8 GB RAM):
# OLLAMA_MODEL=llama3.1:8b

# ── Image Generation ──────────────────────────────────────────────────────────
# Default SD 1.5 (~4 GB VRAM / slow on CPU):
SD_MODEL_ID=runwayml/stable-diffusion-v1-5
# Higher quality SDXL (~8 GB VRAM):
# SD_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

SD_DEVICE=auto        # auto | cuda | cpu
SD_STEPS=25           # lower = faster but lower quality (min ~15)
SD_WIDTH=768
SD_HEIGHT=512

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_ENGINE=pyttsx3    # pyttsx3 (zero download) | coqui (higher quality)
TTS_RATE=145          # words per minute
# COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ── Video ─────────────────────────────────────────────────────────────────────
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# ── Pipeline ──────────────────────────────────────────────────────────────────
MAX_QC_RETRIES=2
